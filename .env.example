# ---------------------------------------------------------------------------
# CartMatch — build-time configuration
#
# Copy to `.env.local` for local development. Never commit `.env.local`.
#
# EVERYTHING IN THIS FILE IS PUBLIC.
# This app is a static site: `NEXT_PUBLIC_*` values are inlined into the bundle
# at build time, and both the bundle and this repository are world-readable.
# Only values that are harmless in the open belong here.
#
# Secrets live in Supabase Edge Function secrets — see the bottom of this file.
# ---------------------------------------------------------------------------

# --- Supabase (sign-in + data) ----------------------------------------------
# Point these at the SAME project as your other apps and you sign in with the
# same email and password — it is literally the same auth.users table.
# CartMatch has no sign-up form on purpose; accounts come from the dashboard.
#
# WHICH KEY GOES HERE. Supabase renamed its keys; you may see either generation
# in Settings > API Keys:
#
#   publishable (sb_publishable_...)  == legacy "anon"          -> HERE
#   secret      (sb_secret_...)       == legacy "service_role"  -> NEVER HERE
#
# The publishable key is DESIGNED to be public. It ships to the browser and is
# powerless on its own: every request it makes is evaluated against Row Level
# Security. The variable keeps the name ANON to match the client library's
# parameter order.
#
# Rule of thumb: if you had to click "reveal" to see it, it is the secret key
# and it does not belong in this file, or anywhere in this repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Data mode --------------------------------------------------------------
# MOCK = fixture prices, labelled MOCK everywhere and never checkout-ready.
# LIVE = real adapters only. Today that means no prices at all, because no
#        retailer adapter is implemented (see README).
NEXT_PUBLIC_CARTMATCH_DATA_MODE=MOCK

# --- Who may use this app ---------------------------------------------------
# Comma-separated emails. Supabase Auth is scoped to a PROJECT, not an app, so
# without this every confirmed user on the project can sign in here — including
# anyone you add later for a different app, silently.
#
# SET THIS IN TWO PLACES:
#   * here, which decides what the UI shows; and
#   * in the Edge Function secrets, which decides what is actually PERMITTED:
#       supabase secrets set CARTMATCH_ALLOWED_EMAILS=you@example.com
#
# On a static site the browser copy protects nothing — anyone can read the
# bundle and skip the check. The Edge Function copy is the real gate. If the
# two disagree, someone is told they have access and then gets a 403 on every
# scan.
#
# Unset admits every project user, so a forgotten value cannot lock you out of
# your own app. The app shows an orange banner when it is unset rather than
# letting you assume otherwise.
NEXT_PUBLIC_CARTMATCH_ALLOWED_EMAILS=

# --- Serving from a project URL instead of a custom domain ------------------
# Only needed when the site lives at https://<user>.github.io/<repo>/ .
# Leave unset for pricecheck.imetrobert.com — setting it breaks every asset
# path on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# NOT IN THIS FILE, AND NEVER IN THE BUNDLE
# ---------------------------------------------------------------------------
# These are read only by supabase/functions/**, which runs on Supabase rather
# than in the browser. Set them with `supabase secrets set`:
#
#   GEMINI_API_KEY             your Gemini key
#   GEMINI_MODEL               default gemini-2.5-flash
#   GEMINI_THINKING_BUDGET     default 0 — recognition is extraction, not
#                              reasoning, and the shopper is waiting
#   CARTMATCH_ALLOWED_EMAILS   the authoritative allowlist (see above)
#   CARTMATCH_ALLOWED_ORIGINS  e.g. https://pricecheck.imetrobert.com
#
# The Supabase SECRET key (sb_secret_..., formerly service_role) is no longer
# used by this app at all. Row Level Security replaced it — see
# supabase/policies.sql. Do not add it anywhere.
