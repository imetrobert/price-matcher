# ---------------------------------------------------------------------------
# CartMatch environment configuration
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every variable here is read SERVER-SIDE ONLY (see src/config/env.ts).
# No key in this file is ever exposed to the browser bundle.
# ---------------------------------------------------------------------------

# --- Gemini (cart photo -> structured product list) -------------------------
# Required for real vision. Without it, vision falls back to MOCK and says so.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Thinking budget in tokens, 2.5-series and later. 0 disables thinking.
# Cart recognition is extraction, not reasoning, and the shopper is standing in
# a store — so the default is 0 to keep the scan fast. Raise it (e.g. 512) only
# if you see the model misreading cluttered or badly-lit carts.
# Ignored on models that predate thinkingConfig.
GEMINI_THINKING_BUDGET=0

# --- Google Programmable Search (optional; used only to DISCOVER candidate
# --- retailer product URLs. A search snippet is NEVER used as a price.
# --- The candidate page must still be fetched and parsed to yield a price.)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Data mode --------------------------------------------------------------
# LIVE  = only real adapters may produce prices. Unimplemented/blocked
#         retailers return UNAVAILABLE. Nothing is invented.
# MOCK  = fixture prices are used and are labelled MOCK everywhere in the UI
#         and API. Mock rows can never be marked checkout-ready.
CARTMATCH_DATA_MODE=MOCK

# --- Networking -------------------------------------------------------------
# Outbound fetch timeout for retailer adapters, milliseconds.
RETAILER_FETCH_TIMEOUT_MS=12000

# --- Privacy ----------------------------------------------------------------
# When true, uploaded cart photos are written to .data/photos for debugging.
# Default false: photos are processed in-memory and discarded.
CARTMATCH_PERSIST_PHOTOS=false

# --- Sign-in (Supabase Auth) ------------------------------------------------
# Point these at the SAME Supabase project as your other apps and you sign in
# to CartMatch with the same email and password — it is literally the same
# auth.users table. Accounts are managed in the Supabase dashboard; CartMatch
# has no sign-up form on purpose.
#
# WHICH KEY GOES HERE
# Supabase renamed its API keys. In the dashboard (Settings > API Keys) you
# will see either the current names or the legacy ones:
#
#   publishable key  (sb_publishable_...)  == legacy "anon" key      -> HERE
#   secret key       (sb_secret_...)       == legacy "service_role"  -> BELOW
#
# Either generation works; the variable name below still says ANON for
# compatibility with the Supabase client libraries' parameter order.
#
# The publishable/anon key is meant to be public: it ships to the browser (the
# login form runs client-side) and carries no privileges of its own — every
# request it makes is evaluated against Row Level Security. The NEXT_PUBLIC_
# prefix is correct and required here.
#
# If you are unsure which key you are holding: the publishable one is shown
# without a "reveal" click. If you had to click to unhide it, it is the secret
# key and it does NOT belong in this variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Require a signed-in session. Defaults to true in production and false in
# development. When true and the keys above are missing, the app returns 503
# rather than serving unprotected — a missing env var must never silently
# expose a deployment.
CARTMATCH_REQUIRE_AUTH=

# Who may use CartMatch, as a comma-separated list of email addresses.
#
# WHY YOU WANT THIS when the Supabase project is shared with other apps:
# Supabase Auth is scoped to a PROJECT, not an app. Every app on the project
# shares one auth.users table, so a valid session for any of them is a valid
# session here. Add a contractor to a different app next month and they get
# CartMatch too — silently, with no action from you.
#
# Setting this decouples them: being on the project becomes necessary but not
# sufficient. Someone signed in but not listed gets a clear "not authorised"
# page, not a redirect loop.
#
# UNSET = every confirmed project user is admitted (the original behaviour,
# kept so a forgotten variable cannot lock you out of your own app). When it is
# unset the app says so, in the UI and in /api/health.
CARTMATCH_ALLOWED_EMAILS=

# --- Storage ----------------------------------------------------------------
# CartMatch uses YOUR EXISTING Supabase project when these two are set, and a
# local JSONL file store otherwise. Nothing else changes between the two.
# Apply supabase/schema.sql to the project once to create the three tables.
#
# ⚠️ This is the SECRET key (sb_secret_...), formerly called "service_role".
# It BYPASSES Row Level Security and can read and write your entire database.
# Server-side only: never prefix it NEXT_PUBLIC_, never import it from a Client
# Component, never paste it into a chat window or an AI assistant.
#
# It is a DIFFERENT key from NEXT_PUBLIC_SUPABASE_ANON_KEY above. SUPABASE_URL
# is the SAME value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: put CartMatch tables in a non-public schema, or rename them to fit
# your existing naming conventions.
SUPABASE_SCHEMA=public
SUPABASE_TABLE_OBSERVATIONS=cartmatch_price_observations
SUPABASE_TABLE_AUDIT=cartmatch_audit_records
SUPABASE_TABLE_VALIDATIONS=cartmatch_validations

# Directory for the local file store (used only when Supabase is not configured).
CARTMATCH_DATA_DIR=.data
