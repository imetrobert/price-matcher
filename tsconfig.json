{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./supabase/functions/_shared/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // Supabase Edge Functions are Deno, not Node: different globals, different
    // module resolution (jsr:/npm: specifiers, .ts import paths). Typechecking
    // them with this config produces only noise. `supabase functions deploy`
    // typechecks them with Deno's own config, which is the one that matters.
    //
    // _shared is deliberately NOT excluded. It holds the offer parser, which
    // the browser and the scheduled worker both run, and it is written to
    // import nothing so it compiles under either. Excluding it would let the
    // app's copy of those rules drift from the worker's, which is the one
    // divergence this project cannot afford.
    "supabase/functions/cartmatch-*"
  ]
}
